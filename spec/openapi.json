  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Регистрация",
        "deprecated": false,
        "description": "Создаёт пользователя и новую сессию. Возвращает пользователя и пару токенов в JSON. Cookie не устанавливает.",
        "operationId": "registerUser",
        "tags": [
          "auth"
        ],
        "parameters": [
          {
            "name": "X-BFF-Key",
            "in": "header",
            "description": "Общий секрет BFF и Go API. Обязателен при включённой проверке S2S; в переходном режиме одной VPS может отсутствовать. Проверяется до Bearer и валидации запроса. Отсутствующий или неверный ключ при включённой проверке: 403 s2s_forbidden. При ротации допускаются текущий и предыдущий ключи; значения не журналируются.",
            "required": false,
            "example": "<bff-key>",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Пользователь и новая пара токенов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "example": {
                  "user": {
                    "id": 1,
                    "login": "example"
                  },
                  "tokens": {
                    "access_token": "<access-token>",
                    "access_expires_in": 900,
                    "refresh_token": "<refresh-token>",
                    "refresh_expires_in": 2592000
                  }
                }
              }
            },
            "headers": {}
          },
          "400": {
            "description": "Невалидный запрос",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {}
          },
          "403": {
            "description": "При включённой проверке S2S заголовок X-BFF-Key отсутствует или неверен. Проверяется до Bearer и валидации запроса. BFF не должен выполнять refresh или удалять пользовательскую сессию.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "s2s_forbidden",
                  "message": "service access forbidden"
                }
              }
            },
            "headers": {}
          },
          "409": {
            "description": "Конфликт",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {}
          },
          "500": {
            "description": "Внутренняя ошибка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
