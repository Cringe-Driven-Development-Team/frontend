    "/auth/refresh": {
      "post": {
        "summary": "Обновление токенов",
        "deprecated": false,
        "description": "Обменивает действующий refresh-токен на новую пару. После успешного обновления старый refresh-токен недействителен. Bearer не требуется. Cookie не читает и не устанавливает.",
        "operationId": "refreshToken",
        "tags": [
          "auth"
        ],
        "parameters": [
          {
            "name": "X-BFF-Key",
            "in": "header",
            "description": "Общий секрет BFF и Go API. Обязателен при включённой проверке S2S; в переходном режиме одной VPS может отсутствовать. Проверяется до Bearer и валидации запроса. Отсутствующий или неверный ключ при включённой проверке: 403 s2s_forbidden. При ротации допускаются текущий и предыдущий ключи; значения не журналируются.",
            "required": false,
            "example": "<bff-key>",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              },
              "example": {
                "refresh_token": "<refresh-token>"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Новая пара токенов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                },
                "example": {
                  "access_token": "<access-token>",
                  "access_expires_in": 900,
                  "refresh_token": "<refresh-token>",
                  "refresh_expires_in": 2592000
                }
              }
            },
            "headers": {}
          },
          "400": {
            "description": "Тело отсутствует, имеет неверную структуру или refresh_token пуст.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "validation_error",
                  "message": "invalid request body"
                }
              }
            },
            "headers": {}
          },
          "401": {
            "description": "Refresh-токен неизвестен, истёк или уже использован.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "unauthorized",
                  "message": "authentication required"
                }
              }
            },
            "headers": {}
          },
          "403": {
            "description": "При включённой проверке S2S заголовок X-BFF-Key отсутствует или неверен. Проверяется до Bearer и валидации запроса. BFF не должен выполнять refresh или удалять пользовательскую сессию.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "s2s_forbidden",
                  "message": "service access forbidden"
                }
              }
            },
            "headers": {}
          },
          "500": {
            "description": "Внутренняя ошибка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
