          "name",
          "updated_at",
          "cells_count"
        ]
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": [
          "login",
          "password"
        ]
      },
      "Cell": {
        "type": "object",
        "description": "Блок блокнота",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "description": "ID блока внутри блокнота"
          },
          "kind": {
            "type": "string",
            "enum": [
              "code",
              "markdown"
            ],
            "description": "Вид блока"
          },
          "source": {
            "type": "string",
            "description": "Содержимое блока"
          }
        },
        "required": [
          "id",
          "kind",
          "source"
        ]
      },
      "CreateCellRequest": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "code",
              "markdown"
            ],
            "description": "Вид блока"
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "description": "Позиция нового блока, с нуля. Без поля блок добавляется в конец"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      "CreateNotebookRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "name"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "validation_error",
              "invalid_credentials",
              "login_taken",
              "unauthorized",
              "not_found",
              "not_implemented",
              "internal",
              "csrf_invalid",
              "s2s_forbidden"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "TokenPair": {
        "type": "object",
