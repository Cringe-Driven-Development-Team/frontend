            "type": "integer",
            "minimum": 1,
            "description": "Срок действия выданного access-токена в секундах",
            "format": "int64",
            "examples": [
              900
            ]
          },
          "refresh_token": {
            "type": "string",
            "description": "Refresh-токен; при обновлении заменяется новым",
            "minLength": 1
          },
          "refresh_expires_in": {
            "type": "integer",
            "description": "Срок действия выданного refresh-токена в секундах",
            "minimum": 1,
            "format": "int64",
            "examples": [
              2592000
            ]
          }
        },
        "required": [
          "access_token",
          "access_expires_in",
          "refresh_token",
          "refresh_expires_in"
        ]
