{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "stream",
    "globalDependencies": [".env"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            // RELEASE_SHA и CDN_URL задаёт CI для релиза: от них зависит base в сборке клиента
            "env": ["RELEASE_SHA", "CDN_URL", "STATIC_URL"],
            "outputs": ["dist/**"]
        },
        "lint": {
            "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxlint.config.ts"]
        },
        "typecheck": {
            "dependsOn": ["^build"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        // turbo watch перезапускает BFF при изменении его файлов и пакетов, которые он импортирует
        // (@cdd/schemas): bun --watch пакеты вне apps/bff на Windows не отслеживает. Без
        // зависимости от ^typecheck изменение в @cdd/schemas BFF не перезапускает
        "@cdd/bff#dev": {
            "dependsOn": ["^typecheck"],
            "cache": false,
            "persistent": true,
            "interruptible": true
        },
        "//#lint:scripts": {
            "inputs": ["scripts/**", "oxlint.config.ts"]
        },
        "//#typecheck:scripts": {
            "inputs": ["scripts/**"]
        }
    }
}
